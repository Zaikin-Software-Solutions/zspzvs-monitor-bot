# =========== Telegram ===========
# Бот @zspzvs_remnawave_limiter_bot — токен из BotFather.
BOT_TOKEN=123456789:AA-replace-with-token-from-BotFather

# Telegram user ID админа. Все подробные сообщения идут сюда в DM.
ADMIN_TG_ID=392686006

# Telegram chat ID канала (число с минусом для супергрупп/каналов).
# Туда идут ТОЛЬКО краткие сообщения о падении/восстановлении хостов и нод.
CHANNEL_ID=-1003667591005

# =========== Источники данных ===========
# Prometheus URL (доступен внутри docker сети monitoring).
PROMETHEUS_URL=http://prometheus:9090

# Postgres Remnawave (читаем nodes.is_connected).
# Имя контейнера в docker сети + порт.
REMNAWAVE_DB_DSN=postgres://postgres:postgres@remnawave-db:5432/postgres

# Remnawave backend API URL (для check_remnawave_api).
REMNAWAVE_BASE_URL=https://crm.zspzvs.ru

# Опционально: путь до docker.sock (host) и systemctl (через nsenter или DBus).
# Бот в первой версии НЕ управляет хостом — только читает. См. ARCHITECTURE.md.

# =========== Хранилище ===========
DB_PATH=/data/bot.db

# =========== Параметры ===========
# Интервал тика проверок (секунды). 120 = каждые 2 минуты, как старый bash.
CHECK_INTERVAL=120

# Сколько подряд "down"-тиков нужно для алерта по xray-checker (как раньше).
HOST_DOWN_THRESHOLD_TICKS=2

# Cooldown между повторными алертами по той же проблеме (секунды).
ALERT_COOLDOWN_SECS=3600

# === Flap-detection ===
# Сколько мини-отвалов (down→up без достижения DOWN-порога) за окно
# должны накопиться чтобы бот прислал отдельный «нестабилен» алерт.
# В DM админу подробности приходят на каждый мини-отвал (восстановилось через N мин),
# в канал — только этот сводный «нестабилен».
FLAP_THRESHOLD_COUNT=3
FLAP_WINDOW_SECS=1800
FLAP_ALERT_COOLDOWN_SECS=3600

# =========== Limiter (нотификации только) ===========
# Включает фоновую проверку нарушений лимита устройств (HWID/IP) у юзеров.
# При срабатывании шлёт DM админу — кнопок «отключить» пока нет, действия через RW-панель.
ENABLE_LIMITER=false

# JWT-токен Remnawave с role=API (тот же, что у syvlech/remnawave-limiter).
REMNAWAVE_API_TOKEN=eyJhbGc...replace-with-jwt-API-role-token

# Секунд между check_violations.
LIMITER_CHECK_INTERVAL=60

# Сколько нарушений за окно надо набрать чтобы кинуть алерт.
LIMITER_VIOLATION_THRESHOLD=3

# Окно скользящего счётчика нарушений (секунды). 3600 = за час.
LIMITER_VIOLATION_WINDOW=3600

# Cooldown между одинаковыми алертами на одного юзера (секунды).
LIMITER_COOLDOWN=300

# IP считается «активным» если lastSeen с ноды младше N секунд.
LIMITER_ACTIVE_IP_WINDOW=120

# === Backup-проверка (R2 / S3-совместимое) ===
# Бот проверяет свежесть последнего бэкапа remnawave_backup_* в R2-бакете.
# Если S3_ENDPOINT пуст — проверка пропускается.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=replace-with-r2-access-key
S3_SECRET_KEY=replace-with-r2-secret-key
S3_BUCKET=remnawave-backup
S3_REGION=auto
S3_PREFIX=
# Алерт если самый свежий бэкап старше N часов.
BACKUP_MAX_AGE_HOURS=26
