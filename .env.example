# =========== Telegram ===========
# Бот @zspzvs_remnawave_limiter_bot — токен из BotFather.
BOT_TOKEN=123456789:AA-replace-with-token-from-BotFather

# Telegram user ID админа. Все подробные сообщения идут сюда в DM.
ADMIN_TG_ID=392686006

# Telegram chat ID канала (число с минусом для супергрупп/каналов).
# Туда идут ТОЛЬКО краткие сообщения о падении/восстановлении хостов и нод.
CHANNEL_ID=-1003667591005

# =========== Источники данных ===========
# Prometheus URL (доступен внутри docker сети monitoring).
PROMETHEUS_URL=http://prometheus:9090

# Postgres Remnawave (читаем nodes.is_connected).
# Имя контейнера в docker сети + порт.
REMNAWAVE_DB_DSN=postgres://postgres:postgres@remnawave-db:5432/postgres

# Remnawave backend API URL (для check_remnawave_api).
REMNAWAVE_BASE_URL=https://crm.zspzvs.ru

# Опционально: путь до docker.sock (host) и systemctl (через nsenter или DBus).
# Бот в первой версии НЕ управляет хостом — только читает. См. ARCHITECTURE.md.

# =========== Хранилище ===========
DB_PATH=/data/bot.db

# =========== Параметры ===========
# Интервал тика проверок (секунды). 120 = каждые 2 минуты, как старый bash.
CHECK_INTERVAL=120

# Сколько подряд "down"-тиков нужно для алерта по xray-checker (как раньше).
HOST_DOWN_THRESHOLD_TICKS=2

# Cooldown между повторными алертами по той же проблеме (секунды).
ALERT_COOLDOWN_SECS=3600
